<?xml version="1.0"?>
<package format="2">
  <name>color_vision</name>
  <version>0.1.0</version>
  <description>Camera color recognition for the Yahboom ROSMASTER X3 Plus (CSIS-370 final project)</description>
  <maintainer email="yahboom@todo.todo">yahboom</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
</package>
